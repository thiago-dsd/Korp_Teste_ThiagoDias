# Copy to .env and adjust as needed. Never commit a filled .env file.

# --- shared ---
SERVICE_TOKEN=local-development-token
CORS_ALLOWED_ORIGINS=http://localhost:4200
LOG_LEVEL=info
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s
RABBITMQ_URL=amqp://korp:korp@localhost:5672/

# --- stock-service ---
STOCK_HTTP_ADDR=:8081
STOCK_DATABASE_URL=postgres://korp:korp@localhost:5433/stock?sslmode=disable

# --- identity-service ---
IDENTITY_HTTP_ADDR=:8083
IDENTITY_DATABASE_URL=postgres://korp:korp@localhost:5433/identity?sslmode=disable
# RSA private key (PEM) used to sign access tokens. When empty a temporary key
# is generated at startup and sessions end when the service restarts.
JWT_PRIVATE_KEY=

# --- billing-service ---
BILLING_HTTP_ADDR=:8082
STOCK_SERVICE_URL=http://localhost:8081
IDENTITY_SERVICE_URL=http://localhost:8083
BILLING_DATABASE_URL=postgres://korp:korp@localhost:5433/billing?sslmode=disable

# --- integration tests ---
STOCK_TEST_DATABASE_URL=postgres://korp:korp@localhost:5433/stock_test?sslmode=disable
BILLING_TEST_DATABASE_URL=postgres://korp:korp@localhost:5433/billing_test?sslmode=disable
IDENTITY_TEST_DATABASE_URL=postgres://korp:korp@localhost:5433/identity_test?sslmode=disable
MESSAGING_TEST_DATABASE_URL=postgres://korp:korp@localhost:5433/messaging_test?sslmode=disable
RABBITMQ_TEST_URL=amqp://korp:korp@localhost:5672/

# --- AI (Microsoft Azure AI Foundry) ---
# Read by the billing service. Without them the drafting assistant is simply
# not offered on the screen and everything else works the same.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21
